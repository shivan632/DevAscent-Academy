generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                  @id @default(cuid())
  email                  String                  @unique
  passwordHash           String
  name                   String
  phone                  String?
  role                   String                  @default("STUDENT")
  degree                 String?
  college                String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  isEmailVerified        Boolean                 @default(false)
  avatarUrl              String?
  bio                    String?
  city                   String?
  githubUrl              String?
  graduationYear         String?
  linkedinUrl            String?
  portfolioUrl           String?
  adminNote              String?
  lastLoginAt            DateTime?
  status                 String                  @default("ACTIVE")
  suspendedAt            DateTime?
  auditLogsAsAdmin       AuditLog[]              @relation("AdminAuditLogs")
  certificates           Certificate[]
  completionSubmissions  CompletionSubmission[]
  doubts                 Doubt[]
  enrollments            Enrollment[]
  internshipApplications InternshipApplication[]
  lessonProgress         LessonProgress[]
  payments               Payment[]
  quizSubmissions        QuizSubmission[]
  refunds                Refund[]
}

model OtpVerification {
  id        String   @id @default(cuid())
  email     String   @unique
  code      String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Course {
  id                     String                  @id @default(cuid())
  slug                   String                  @unique
  title                  String
  description            String
  priceInPaise           Int                     @default(499900)
  earlyBirdPriceInPaise  Int                     @default(149900)
  domain                 String                  @default("fullstack")
  level                  String                  @default("Intermediate")
  thumbnail              String
  cohortNumber           Int                     @default(14)
  seatsRemaining         Int                     @default(9)
  totalSeats             Int                     @default(40)
  cohortStartsOn         DateTime?
  isPublished            Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  assignments            String                  @default("[]")
  durationWeeks          Int?                    @default(8)
  isFree                 Boolean                 @default(false)
  isPaidInternship       Boolean                 @default(false)
  objectives             String                  @default("[]")
  projects               String                  @default("[]")
  requirements           String                  @default("[]")
  requiresApproval       Boolean                 @default(false)
  stipendDetails         String?
  type                   String                  @default("COURSE")
  certificates           Certificate[]
  completionSubmissions  CompletionSubmission[]
  enrollments            Enrollment[]
  internshipApplications InternshipApplication[]
  modules                Module[]
  payments               Payment[]
}

model Module {
  id           String   @id @default(cuid())
  courseId     String
  moduleNumber Int
  title        String
  description  String?
  lessons      Lesson[]
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  quiz         Quiz?
}

model Lesson {
  id               String           @id @default(cuid())
  moduleId         String
  lessonNumber     Int
  title            String
  durationMinutes  Int              @default(15)
  videoUrl         String?
  isFreePreview    Boolean          @default(false)
  summary          String?
  exercisePdfTitle String?
  exercisePdfUrl   String?
  exerciseProjects String?          @default("[]")
  writtenContent   String?
  doubts           Doubt[]
  module           Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progressRecords  LessonProgress[]
  quiz             Quiz?
}

model Quiz {
  id           String           @id @default(cuid())
  moduleId     String?          @unique
  title        String
  passingScore Int              @default(60)
  lessonId     String?          @unique
  lesson       Lesson?          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  module       Module?          @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions    QuizQuestion[]
  submissions  QuizSubmission[]
}

model QuizQuestion {
  id                 String  @id @default(cuid())
  quizId             String
  question           String
  optionsJson        String
  correctOptionIndex Int
  explanation        String?
  codeSnippet        String?
  quiz               Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizSubmission {
  id          String   @id @default(cuid())
  userId      String
  quizId      String
  scorePct    Int
  passed      Boolean
  submittedAt DateTime @default(now())
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Doubt {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  question  String
  answer    String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@index([userId])
}

model Enrollment {
  id          String   @id @default(cuid())
  userId      String
  courseId    String
  progressPct Int      @default(0)
  status      String   @default("ACTIVE")
  enrolledAt  DateTime @default(now())
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model LessonProgress {
  id             String   @id @default(cuid())
  userId         String
  lessonId       String
  watchedSeconds Int      @default(0)
  isCompleted    Boolean  @default(false)
  lastWatchedAt  DateTime @default(now())
  lesson         Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Payment {
  id                String   @id @default(cuid())
  userId            String
  courseId          String
  razorpayOrderId   String   @unique
  razorpayPaymentId String?  @unique
  razorpaySignature String?
  amountInPaise     Int
  currency          String   @default("INR")
  status            String   @default("PENDING")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  couponCode        String?
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refunds           Refund[]
}

model Certificate {
  id            String   @id @default(cuid())
  certId        String   @unique
  userId        String
  courseId      String
  recipientName String
  courseTitle   String
  sha256Hash    String   @unique
  grade         String   @default("A+")
  pdfUrl        String?
  issuedAt      DateTime @default(now())
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Refund {
  id              String    @id @default(cuid())
  paymentId       String
  userId          String
  amountInPaise   Int
  reason          String
  upiId           String?
  status          String    @default("SUBMITTED")
  rejectionReason String?
  createdAt       DateTime  @default(now())
  processedAt     DateTime?
  payment         Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InternshipApplication {
  id         String    @id @default(cuid())
  userId     String
  courseId   String
  status     String    @default("PENDING")
  adminNote  String?
  appliedAt  DateTime  @default(now())
  reviewedAt DateTime?
  course     Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model CompletionSubmission {
  id              String    @id @default(cuid())
  userId          String
  courseId        String
  name            String
  email           String
  batch           String
  projectName     String
  gitRepoUrl      String
  linkedinPostUrl String
  status          String    @default("PENDING")
  adminNote       String?
  submittedAt     DateTime  @default(now())
  reviewedAt      DateTime?
  course          Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetId   String?
  targetType String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  admin      User     @relation("AdminAuditLogs", fields: [adminId], references: [id])

  @@index([adminId, createdAt])
  @@index([action, createdAt])
}
