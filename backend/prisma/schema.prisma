generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                  @id @default(cuid())
  email                  String                  @unique
  passwordHash           String
  name                   String
  phone                  String?
  role                   String                  @default("STUDENT")
  degree                 String?
  college                String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  isEmailVerified        Boolean                 @default(false)
  avatarUrl              String?
  bio                    String?
  city                   String?
  githubUrl              String?
  graduationYear         String?
  linkedinUrl            String?
  portfolioUrl           String?
  adminNote              String?
  lastLoginAt            DateTime?
  status                 String                  @default("ACTIVE")
  suspendedAt            DateTime?
  auditLogsAsAdmin       AuditLog[]              @relation("AdminAuditLogs")
  certificates           Certificate[]
  completionSubmissions  CompletionSubmission[]
  doubts                 Doubt[]
  enrollments            Enrollment[]
  internshipApplications InternshipApplication[]
  lessonProgress         LessonProgress[]
  payments               Payment[]
  quizSubmissions        QuizSubmission[]
  quizAttempts           QuizAttempt[]
  aiVideoProgress        AiVideoProgress[]
  refunds                Refund[]
  couponsCreated         Coupon[]                @relation("CouponCreator")
  doubtsAnswered         Doubt[]                 @relation("DoubtAnswerer")
  notificationsSent      Notification[]          @relation("NotificationSender")
  notificationReads      NotificationRead[]
  announcementsCreated   Announcement[]          @relation("AnnouncementCreator")
  directNotifications    Notification[]          @relation("StudentDirectNotifications")
  academicDocuments      AcademicDocument[]
}

model OtpVerification {
  id        String   @id @default(cuid())
  email     String   @unique
  code      String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Course {
  id                     String                  @id @default(cuid())
  slug                   String                  @unique
  title                  String
  description            String
  priceInPaise           Int                     @default(499900)
  earlyBirdPriceInPaise  Int                     @default(149900)
  domain                 String                  @default("fullstack")
  level                  String                  @default("Intermediate")
  thumbnail              String
  cohortNumber           Int                     @default(14)
  seatsRemaining         Int                     @default(9)
  totalSeats             Int                     @default(40)
  cohortStartsOn         DateTime?
  isPublished            Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  assignments            String                  @default("[]")
  durationWeeks          Int?                    @default(8)
  isFree                 Boolean                 @default(false)
  isPaidInternship       Boolean                 @default(false)
  objectives             String                  @default("[]")
  projects               String                  @default("[]")
  requirements           String                  @default("[]")
  requiresApproval       Boolean                 @default(false)
  stipendDetails         String?
  type                   String                  @default("COURSE")
  projectPdfUrl          String?
  projectPdfTitle        String?
  projectUploadedAt      DateTime?
  certificates           Certificate[]
  completionSubmissions  CompletionSubmission[]
  enrollments            Enrollment[]
  internshipApplications InternshipApplication[]
  modules                Module[]
  payments               Payment[]
  aiVideos               AiVideo[]
  coupons                Coupon[]                @relation("CourseCoupons")
  doubts                 Doubt[]
  notifications          Notification[]          @relation("CourseNotifications")
  announcements          Announcement[]          @relation("CourseAnnouncements")
  academicDocuments      AcademicDocument[]
}

model AiVideo {
  id                String            @id @default(cuid())
  courseId          String
  order             Int               // 1, 2, or 3
  title             String
  description       String?
  videoUrl          String
  durationSec       Int               @default(15) // 15, 20, etc.
  unlocksFromLesson Int               @default(1)
  unlocksToLesson   Int               @default(5)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  course            Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress          AiVideoProgress[]

  @@unique([courseId, order])
}

model AiVideoProgress {
  id        String    @id @default(cuid())
  userId    String
  aiVideoId String
  watched   Boolean   @default(false)
  watchedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  aiVideo   AiVideo   @relation(fields: [aiVideoId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, aiVideoId])
  @@index([userId, watched])
}

model Module {
  id           String   @id @default(cuid())
  courseId     String
  moduleNumber Int
  title        String
  description  String?
  lessons      Lesson[]
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  quiz         Quiz?
}

model Lesson {
  id               String           @id @default(cuid())
  moduleId         String
  lessonNumber     Int
  title            String
  durationMinutes  Int?             @default(15)
  isFreePreview    Boolean          @default(false)
  summary          String?
  notesPdfUrl      String?
  notesUploadedAt  DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt
  doubts           Doubt[]
  module           Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progressRecords  LessonProgress[]
  quiz             Quiz?

  @@index([moduleId, lessonNumber])
}

model Quiz {
  id           String           @id @default(cuid())
  moduleId     String?          @unique
  lessonId     String?          @unique
  title        String
  passingScore Int              @default(70)
  maxAttempts  Int              @default(3)
  timeLimitMin Int?             @default(15) // Quiz timer in minutes
  createdAt    DateTime         @default(now())
  lesson       Lesson?          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  module       Module?          @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions    QuizQuestion[]
  submissions  QuizSubmission[]
  attempts     QuizAttempt[]
}

model QuizQuestion {
  id                 String  @id @default(cuid())
  quizId             String
  order              Int     @default(1)
  question           String
  questionText       String?
  optionsJson        String? @default("[]")
  options            String[] @default([])
  correctOptionIndex Int     @default(0)
  explanation        String?
  codeSnippet        String?
  quiz               Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizSubmission {
  id          String   @id @default(cuid())
  userId      String
  quizId      String
  scorePct    Int
  passed      Boolean
  submittedAt DateTime @default(now())
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id               String    @id @default(cuid())
  userId           String
  quizId           String
  score            Int       // 0-100
  passed           Boolean   @default(false)
  answers          Json      // { questionId: selectedIndex }
  attemptNum       Int       @default(1) // 1, 2, or 3
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  timeSpentSeconds Int?
  createdAt        DateTime  @default(now())
  quiz             Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, quizId])
  @@index([userId, quizId, passed])
}

model Doubt {
  id           String    @id @default(cuid())
  userId       String
  courseId     String?
  lessonId     String?
  question     String
  answer       String?
  status       String    @default("PENDING") // PENDING | ANSWERED
  isUrgent     Boolean   @default(false)
  answeredById String?
  answeredAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  course       Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson       Lesson?   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  answeredBy   User?     @relation("DoubtAnswerer", fields: [answeredById], references: [id])

  @@index([courseId, status])
  @@index([lessonId])
  @@index([userId])
  @@index([createdAt])
}

model Enrollment {
  id          String   @id @default(cuid())
  userId      String
  courseId    String
  progressPct Int      @default(0)
  status      String   @default("ACTIVE")
  enrolledAt  DateTime @default(now())
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model LessonProgress {
  id             String    @id @default(cuid())
  userId         String
  lessonId       String
  watchedSeconds Int       @default(0)
  isCompleted    Boolean   @default(false)
  completed      Boolean   @default(false)
  lastWatchedAt  DateTime  @default(now())
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  lesson         Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, isCompleted])
}

model Payment {
  id                String   @id @default(cuid())
  userId            String
  courseId          String
  razorpayOrderId   String   @unique
  razorpayPaymentId String?  @unique
  razorpaySignature String?
  amountInPaise     Int
  currency          String   @default("INR")
  status            String   @default("PENDING")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  couponCode        String?
  couponId          String?
  originalAmount    Int?
  discountApplied   Int?
  coupon            Coupon?  @relation("CouponPayments", fields: [couponId], references: [id])
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refunds           Refund[]
}

model Certificate {
  id            String   @id @default(cuid())
  certId        String   @unique
  userId        String
  courseId      String
  recipientName String
  courseTitle   String
  sha256Hash    String   @unique
  grade         String   @default("A+")
  pdfUrl        String?
  issuedAt      DateTime @default(now())
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Refund {
  id              String    @id @default(cuid())
  paymentId       String
  userId          String
  amountInPaise   Int
  reason          String
  upiId           String?
  status          String    @default("SUBMITTED")
  rejectionReason String?
  createdAt       DateTime  @default(now())
  processedAt     DateTime?
  payment         Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InternshipApplication {
  id         String    @id @default(cuid())
  userId     String
  courseId   String
  status     String    @default("PENDING")
  adminNote  String?
  appliedAt  DateTime  @default(now())
  reviewedAt DateTime?
  course     Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model CompletionSubmission {
  id              String    @id @default(cuid())
  userId          String
  courseId        String
  name            String
  email           String
  batch           String
  projectName     String
  gitRepoUrl      String
  linkedinPostUrl String
  status          String    @default("PENDING")
  adminNote       String?
  submittedAt     DateTime  @default(now())
  reviewedAt      DateTime?
  course          Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetId   String?
  targetType String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  admin      User     @relation("AdminAuditLogs", fields: [adminId], references: [id])

  @@index([adminId, createdAt])
  @@index([action, createdAt])
}

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  description   String?
  discountType  String    // "PERCENT" | "FLAT"
  discountValue Int       // PERCENT: 1-100, FLAT: paise
  maxUses       Int       @default(1)
  usedCount     Int       @default(0)
  expiresAt     DateTime?
  isActive      Boolean   @default(true)
  courseId      String?
  course        Course?   @relation("CourseCoupons", fields: [courseId], references: [id])
  isAutoApply   Boolean   @default(false)
  createdById   String?
  createdBy     User?     @relation("CouponCreator", fields: [createdById], references: [id])
  payments      Payment[] @relation("CouponPayments")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([code, isActive])
  @@index([expiresAt])
}

model Announcement {
  id             String         @id @default(cuid())
  title          String
  message        String
  type           String         @default("ANNOUNCEMENT") // ANNOUNCEMENT | ALERT | INFO | SYSTEM
  targetRole     String         @default("ALL")          // ALL | STUDENT | ADMIN
  targetCohort   Int?
  targetCourseId String?
  targetCourse   Course?        @relation("CourseAnnouncements", fields: [targetCourseId], references: [id], onDelete: Cascade)
  createdById    String?
  createdBy      User?          @relation("AnnouncementCreator", fields: [createdById], references: [id])
  notifications  Notification[] @relation("AnnouncementNotifications")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([targetRole, createdAt])
  @@index([targetCourseId])
}

model Notification {
  id             String             @id @default(cuid())
  title          String
  message        String
  type           String             @default("INFO") // INFO | ALERT | ANNOUNCEMENT | SYSTEM
  targetRole     String             @default("ALL")  // ALL | STUDENT | ADMIN
  targetCohort   Int?
  targetCourseId String?
  targetCourse   Course?            @relation("CourseNotifications", fields: [targetCourseId], references: [id], onDelete: Cascade)
  announcementId String?
  announcement   Announcement?      @relation("AnnouncementNotifications", fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?              @relation("StudentDirectNotifications", fields: [userId], references: [id], onDelete: Cascade)
  createdById    String?
  createdBy      User?              @relation("NotificationSender", fields: [createdById], references: [id])
  reads          NotificationRead[]
  createdAt      DateTime           @default(now())

  @@index([targetRole, createdAt])
  @@index([targetCourseId])
  @@index([announcementId])
  @@index([userId])
}

model NotificationRead {
  id             String       @id @default(cuid())
  userId         String
  notificationId String
  readAt         DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId])
  @@index([userId])
}

model AcademicDocument {
  id              String   @id @default(cuid())
  docId           String   @unique // e.g. DEV-OL-2026-7A9B or DEV-LOR-2026-4C1F
  type            String   // "OFFER_LETTER" | "LOR"
  userId          String
  courseId        String
  enrollmentId    String?
  recipientName   String
  courseTitle     String
  durationWeeks   Int      @default(4)
  sha256Hash      String   @unique
  metadata        Json?
  pdfUrl          String?
  issuedAt        DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([docId])
}



